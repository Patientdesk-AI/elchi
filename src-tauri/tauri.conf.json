{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eshlik",
  "version": "1.0.8",
  "identifier": "com.elchi.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": ["resources/**/*"],
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/tr.lproj/InfoPlist.strings": "macos/tr.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "macos/en.lproj/InfoPlist.strings"
      },
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libgtk-layer-shell0", "libopenblas0"],
        "files": {
          "/usr/lib/Eshlik": "transcribe-libs"
        },
        "recommends": ["xdotool", "wtype"],
        "provides": ["elchi"],
        "conflicts": ["elchi"],
        "replaces": ["elchi"]
      },
      "rpm": {
        "depends": [
          "libgtk-layer-shell.so.0()(64bit)",
          "libopenblas.so.0()(64bit)"
        ],
        "compression": {
          "type": "none"
        },
        "files": {
          "/usr/lib/Eshlik": "transcribe-libs"
        },
        "provides": ["elchi"],
        "obsoletes": ["elchi"]
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib": "transcribe-libs"
        }
      }
    },
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBRjA5RDI0NjFGNEVFQkMKUldTODd2UmhKSjN3cWlDeFl4Ykk4ZjJKYVg1bUZVQ1VocGVNd1dHODJiUkFWajVCZXhOcDVBYnMK",
      "endpoints": ["https://speech.patientdesk.ai/downloads/elchi/latest.json"]
    }
  }
}
